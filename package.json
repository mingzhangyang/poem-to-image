{
  "name": "inkpoem",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:worker": "npm run build && wrangler dev --port 8787",
    "build": "vite build",
    "verify:build": "node scripts/verify-build.mjs",
    "preview": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "cf:typegen": "wrangler types",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "node --import tsx --test tests/frontend/*.test.ts tests/worker/auth-claims.test.ts tests/worker/billing-validation.test.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:e2e": "playwright test",
    "verify": "npm run cf:typegen && npm run typecheck && npm run lint && npm test && npm run build && npm run verify:build",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit:full": "npm audit --audit-level=high",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@clerk/react": "^6.12.5",
    "@google/genai": "^2.12.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "minimatch@9.0.9": {
      "brace-expansion": "^2.1.7"
    },
    "protobufjs": "^7.6.3",
    "ws": "^8.21.1"
  }
}
