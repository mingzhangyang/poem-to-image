{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poem-to-image-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/s/*"]
  },
  "r2_buckets": [
    {
      "binding": "ARTWORKS",
      "bucket_name": "inkpoem-shared-artworks-staging"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "poem-to-image-staging",
      "database_id": "REPLACE_WITH_STAGING_D1_DATABASE_ID",
      "migrations_dir": "worker/migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
